{
	"version": "0.2",
	"allowCompoundWords": true,
	"cache": {
		"useCache": true
	},
	"files": ["**/*.{ts,mts,vue,md}", "**/*.d.ts"],
	"useGitignore": true,
	"ignorePaths": [
		"docs",
		"cspell.json",
		"*.css",
		"**/*.gdb",
		"**/*.tbx",
		"**/*.atbx",
		"**/*.svg",
		"**/*.stylx",
		"**/*.aprx",
		"**/*.ppkx",
		"wsdot-devops-pipeline-yaml-schema.json",
		"package.json",
		"package-lock-json",
		"**/assets/TravelInformation2DSymbols"
	],
	"patterns": [
		{
			"name": "gtag_id",
			"pattern": "\\bG-\\S+\\b"
		}
	],
	"ignoreRegExpList": ["gtag_id"],
	"dictionaryDefinitions": [
		{
			"name": "custom-dictionary",
			"path": "./.cspell/custom-dictionary.txt",
			"addWords": true,
			"scope": "workspace"
		}
	],
	"dictionaries": ["custom-dictionary"],
	"words": [],
	"ignoreWords": [
		"ERESOLVE",
		"Nums",
		"browserslist",
		"browserslistrc",
		"doubleclick",
		"featureid",
		"geoms",
		"jurdsg",
		"jurlbl",
		"lyrs",
		"netconfig",
		"npmrc",
		"parkride",
		"pjson",
		"restarea",
		"scripthost",
		"splide",
		"tsbuildinfo"
	],
	"import": []
}
