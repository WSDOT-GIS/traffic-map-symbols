{
  "name": "wsdot-travel-center-map",
  "version": "1.0.8",
  "private": true,
  "scripts": {
    "prepare": "npm run docs",
    "clean": "git clean -dfx -e node_modules",
    "dotnet-serve": "dotnet serve --path-base /Travel/Real-time/Map/ --directory dist",
    "docs": "typedoc",
    "serve": "vue-cli-service serve",
    "lighthouse": "node ./tools/run-lighthouse.mjs",
    "build": "vue-cli-service build --modern",
    "lint": "vue-cli-service lint --no-fix",
    "lint:html": "vue-cli-service lint --no-fix --format html > dist/lint-results.html",
    "spell-ci": "cspell lint **/* --fail-fast --no-progress --no-summary",
    "tsc:symbols": "tsc --project symbols.tsconfig"
  },
  "dependencies": {
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@analytics/google-analytics": "^1.0.3",
    "@arcgis/core": "^4.24.7",
    "@arcgis/webpack-plugin": "^4.22.0",
    "@microsoft/applicationinsights-web": "^2.8.6",
    "@splidejs/vue-splide": "^0.6.7",
    "@types/doubleclick-gpt": "^2019111201.0.2",
    "@types/webpack-env": "^1.17.0",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "@vue/cli-plugin-eslint": "^5.0.8",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "@vue/eslint-config-typescript": "^11.0.0",
    "analytics": "^0.8.1",
    "chrome-launcher": "^0.15.1",
    "core-js": "^3.24.1",
    "cspell": "^6.6.0",
    "eslint": "^8.21.0",
    "eslint-plugin-tsdoc": "^0.2.16",
    "eslint-plugin-vue": "^9.3.0",
    "lighthouse": "^9.6.5",
    "polygon-clipping": "^0.15.3",
    "source-map": "^0.7.4",
    "typedoc": "^0.23.10",
    "typedoc-plugin-coverage": "^2.0.0",
    "typedoc-plugin-markdown": "^3.13.4",
    "typescript": "^4.7.4",
    "vue-cli-plugin-compression": "^1.2.0",
    "vue-cli-plugin-webpack-bundle-analyzer": "^4.0.0",
    "vue-responsive-components": "^0.2.3",
    "vue-router": "^4.1.3",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-click-away": "^1.2.4",
    "vuex": "^4.0.2"
  },
  "prettier": {
    "printWidth": 100
  },
  "description": "This repository contains the source code for the [WSDOT Travel Center Map]",
  "main": "src/main.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "https://WSDOT@dev.azure.com/WSDOT/TravelerInformation/_git/TravelerInformationCoreMap"
  },
  "keywords": [
    "wsdot",
    "travel",
    "traffic",
    "borders",
    "weather"
  ],
  "override": {
    "intl-messageformat-parser": "@formatjs/icu-messageformat-parser"
  },
  "author": "",
  "license": "Unlicense"
}
